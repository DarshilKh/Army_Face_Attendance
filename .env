# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=123@
DB_NAME=army_attendance

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
DEBUG=True

# Network Camera Configuration
CAMERA_URL=http://192.168.1.65/
CAMERA_USERNAME=admin
CAMERA_PASSWORD=admin123

# Face Recognition Configuration
# Threshold for face matching (lower = stricter, higher accuracy)
FACE_THRESHOLD=0.3

# Minimum face size in pixels (larger = clearer faces)
MIN_FACE_SIZE=80

# Face quality score (0.0-1.0, higher = better quality)
MIN_FACE_QUALITY=0.50

# InsightFace model (buffalo_l = better accuracy)
INSIGHTFACE_MODEL=buffalo_l
# Detection image size (larger = more accurate)
DETECTION_SIZE=800,800

# Liveness detection
LIVENESS_REQUIRED=True
LIVENESS_THRESHOLD=0.7

# Security
SESSION_TIMEOUT=1800
MAX_LOGIN_ATTEMPTS=3
ENCRYPT_IMAGES=True
